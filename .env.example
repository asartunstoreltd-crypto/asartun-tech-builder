# Copy to .env.local (never commit it). Only the PUBLIC anon key belongs in the frontend.
# NEVER put the Supabase service_role key in any VITE_* variable or any frontend file.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ASARTUN ADULT LEARNING (optional). Learners sign in with phone + PIN; the phone becomes an internal login name <digits>@<this domain>.
# It is never emailed. It MUST match the ADULT_LOGIN_DOMAIN secret of the adult-admin Edge Function. Default shown.
VITE_ADULT_LOGIN_DOMAIN=adult.asartun.invalid
